{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/protocol_guard.py"
            ],
            "timeoutMs": 1000,
            "statusMessage": "Checking Protocol project-area write guard"
          }
        ]
      }
    ]
  }
}
